digraph G {
    rankdir=TB;
    fontname="Microsoft YaHei";
    fontsize=14;
    label="STM32F107VCT6 — task7 梯形加减速架构图";
    labelloc=t;
    nodesep=0.3;
    ranksep=0.5;
    compound=true;
    newrank=true;
    bgcolor="#fafafa";

    subgraph cluster_state {
        label="电机状态机 (motor_t)";
        fontsize=14; fontname="Microsoft YaHei";
        style="filled"; fillcolor="#fce4ec"; color="#880e4f"; penwidth=2;

        ms_stop [label="MOTOR_STOP\n步数=0\n定时器停止", shape=circle, style="filled", fillcolor="#f8bbd0", fontsize=9, fontname="Microsoft YaHei"];
        ms_accel [label="MOTOR_ACCEL\n离散加速公式\nnext=PULSE-((2*PULSE+rest)/(4*n+1))", shape=circle, style="filled", fillcolor="#f48fb1", fontsize=9, fontname="Microsoft YaHei"];
        ms_run [label="MOTOR_RUN\n匀速运行\n目标脉冲频率", shape=circle, style="filled", fillcolor="#ec407a", fontcolor="white", fontsize=9, fontname="Microsoft YaHei"];
        ms_decel [label="MOTOR_DECEL\n减速计数decel_val\n→STOP时置target_reached", shape=circle, style="filled", fillcolor="#f48fb1", fontsize=9, fontname="Microsoft YaHei"];

        ms_stop -> ms_accel [label="MotorStart()", fontsize=8, fontname="Microsoft YaHei"];
        ms_accel -> ms_run [label="current_hz\ncatches target", fontsize=8, fontname="Microsoft YaHei"];
        ms_accel -> ms_decel [label="三角形轮廓\n(无匀速段)", fontsize=8, fontname="Microsoft YaHei", style=dashed];
        ms_run -> ms_decel [label="step>=\ndecel_start", fontsize=8, fontname="Microsoft YaHei"];
        ms_decel -> ms_stop [label="decel_val<=1\n定时器停止", fontsize=8, fontname="Microsoft YaHei"];
    }

    subgraph cluster_isr {
        label="中断层 (ISR)";
        fontsize=14; fontname="Microsoft YaHei";
        style="filled"; fillcolor="#fff3e0"; color="#e65100"; penwidth=2;

        tim5 [label="TIM5 CH1 (OC Toggle)\n━━━━━━━━━━━━━━━━\nARR=0xFFFF 固定\nCCR1动态更新: ccr+=interval\n中断源: TIM_IT_CC1\n每次CC1匹配翻转PA0\n两个翻转=1个完整脉冲\n实现梯形运动轮廓\n无FreeRTOS API调用(标志位通知)",
            shape=box, style="filled,rounded", fillcolor="#ffe0b2", fontsize=9, fontname="Microsoft YaHei"];
        tim1 [label="TIM1_UP\n1ms 系统时基\nsysTick_ms计数", shape=box, style="filled,rounded", fillcolor="#ffe0b2", fontsize=9, fontname="Microsoft YaHei"];
    }

    subgraph cluster_hw {
        label="硬件外设";
        fontsize=14; fontname="Microsoft YaHei";
        style="filled"; fillcolor="#e0f2f1"; color="#004d40"; penwidth=2;

        motor [label="UIM240 步进电机\nPA0=PUL PE12=DIR PB11=ENA\n1600脉冲/圈(200步×8细分)", shape=box, style="filled,rounded", fillcolor="#b2dfdb", fontsize=9, fontname="Microsoft YaHei"];
        oled [label="SSD1306 OLED\n128x64 I2C", shape=box, style="filled,rounded", fillcolor="#b2dfdb", fontsize=9, fontname="Microsoft YaHei"];
        led [label="LED PE3/PE4\n4模式状态指示", shape=box, style="filled,rounded", fillcolor="#b2dfdb", fontsize=9, fontname="Microsoft YaHei"];
        dyp [label="DYP-A02\nRS485 Modbus", shape=box, style="filled,rounded", fillcolor="#b2dfdb", fontsize=9, fontname="Microsoft YaHei"];
        host [label="上位机\nUSART3 115200", shape=box, style="filled,rounded", fillcolor="#b2dfdb", fontsize=9, fontname="Microsoft YaHei"];
    }

    subgraph cluster_api {
        label="PascalCase API 层";
        fontsize=14; fontname="Microsoft YaHei";
        style="filled"; fillcolor="#e8f5e9"; color="#2e7d32"; penwidth=2;

        motor_api [label="Motor.c/h\n━━━━━━━━━━━━━━━━\nMotorInit() MotorStart()\nMotorStop() MotorSetSpeed()\nMotorSetAccel() MotorSetDecel()\nMotorSetTargetUnit()\nMotorSetConstant() (内部)\nusqrt() 整数开方\nMotorPulsesToUnit() 单位转换",
            shape=box, style="filled,rounded", fillcolor="#c8e6c9", fontsize=9, fontname="Microsoft YaHei"];

        led_api [label="Led.c/h\n━━━━━━━━━━━━━━━━\nLedOn() LedOff()\nPE3/PE4 低电平有效",
            shape=box, style="filled,rounded", fillcolor="#c8e6c9", fontsize=9, fontname="Microsoft YaHei"];

        bsp_api [label="Bsp.c/h\n━━━━━━━━━━━━━━━━\nBspInit() DelayMs()\nGpioInit() TimerInit()\nUsartInit() OledInit()",
            shape=box, style="filled,rounded", fillcolor="#c8e6c9", fontsize=9, fontname="Microsoft YaHei"];

        sensor_api [label="Sensor (485)\n━━━━━━━━━━━━━━\nGetTemperature()\nGetDistance()\nRS485 Modbus通信",
            shape=box, style="filled,rounded", fillcolor="#c8e6c9", fontsize=9, fontname="Microsoft YaHei"];
    }

    subgraph cluster_macro {
        label="宏定义常量 (~50个)";
        fontsize=14; fontname="Microsoft YaHei";
        style="filled"; fillcolor="#f3e5f5"; color="#6a1b9a"; penwidth=2;

        macros [label="━━ 系统时钟 ━━\nMOTOR_TIM_CLK_HZ=72MHz\nMOTOR_TIM_PRESCALER=8\n\n━━ 步进参数 ━━\nMOTOR_PULSES_PER_REV=1600\n\n━━ 速度范围 ━━\nMOTOR_MIN_HZ=400\nMOTOR_MAX_HZ=3200\nMOTOR_DEFAULT_SPEED_HZ=1600\n\n━━ 加减速 ━━\nMOTOR_RAMP_STEP_HZ=10\n\n━━ 目标脉冲 ━━\nMOTOR_DEFAULT_TARGET=10000000\nMOTOR_MIDPOINT_PULSES=2800\n\n━━ 单位转换宏 ━━\nPULSES_TO_UNIT() / UNIT_TO_PULSES()\nHZ_TO_SPEED() / SPEED_TO_HZ()",
            shape=box, style="filled,rounded", fillcolor="#e1bee7", fontsize=9, fontname="Microsoft YaHei"];
    }

    subgraph cluster_main {
        label="main.c (裸机测试模式)";
        fontsize=14; fontname="Microsoft YaHei";
        style="filled"; fillcolor="#e3f2fd"; color="#1565c0"; penwidth=2;

        main [label="main()\n━━━━━━━━━━━━━━━━\nBspInit()\nDelayMs(100)\nMotorSetAccel(100)    // 1 rev/s²\nMotorSetDecel(100)\nMotorSetSpeed(100)    // 1 rev/s\nMotorSetTargetUnit(500) // 5圈\nMotorStart()\n// vFreeRtosStart() 注释掉\nwhile(1) { }\n\n注: 7个任务已定义但xTaskCreate\n    全部注释,用于裸机电机验证",
            shape=box, style="filled,rounded", fillcolor="#bbdefb", fontsize=9, fontname="Microsoft YaHei"];
    }

    main -> bsp_api [style=bold, color="#2e7d32"];
    bsp_api -> motor_api [color="#1565c0"];
    bsp_api -> led_api [color="#1565c0"];
    bsp_api -> sensor_api [color="#1565c0"];

    motor_api -> motor [label="PA0/PE12/PB11", fontsize=8, fontname="Microsoft YaHei", color="#004d40"];
    led_api -> led [label="PE3/PE4", fontsize=8, fontname="Microsoft YaHei", color="#004d40"];
    sensor_api -> dyp [label="RS485", fontsize=8, fontname="Microsoft YaHei", color="#004d40"];

    motor_api -> tim5 [label="TIM5 OC Toggle\nCCR1动态更新", fontsize=8, fontname="Microsoft YaHei", color="#e65100"];
    bsp_api -> tim1 [label="TIM1 1ms时基", fontsize=8, fontname="Microsoft YaHei", color="#e65100"];
    bsp_api -> oled [label="I2C", fontsize=8, fontname="Microsoft YaHei", color="#004d40"];
    bsp_api -> host [label="USART3", fontsize=8, fontname="Microsoft YaHei", color="#004d40"];

    macros -> motor_api [style=dashed, color="#6a1b9a", fontsize=8, fontname="Microsoft YaHei"];
}

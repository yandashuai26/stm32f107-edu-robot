digraph G {
    rankdir=LR;
    fontname="Microsoft YaHei";
    fontsize=14;
    label="STM32F107VCT6 — v3.0 IPC 数据流图";
    labelloc=t;
    nodesep=0.3;
    ranksep=0.4;
    compound=true;
    bgcolor="#fafafa";

    subgraph cluster_src {
        label="中断源 / 生产者";
        fontsize=14; fontname="Microsoft YaHei";
        style="filled"; fillcolor="#ffebee"; color="#c62828"; penwidth=2;

        src1 [label="EXTI\n限位触发", shape=box, style="filled,rounded", fillcolor="#ffcdd2", fontsize=10, fontname="Microsoft YaHei"];
        src2 [label="USART3\n指令接收", shape=box, style="filled,rounded", fillcolor="#ffcdd2", fontsize=10, fontname="Microsoft YaHei"];
        src3 [label="TIM5\n脉冲到达", shape=box, style="filled,rounded", fillcolor="#ffcdd2", fontsize=10, fontname="Microsoft YaHei"];
        src4 [label="vTaskCollect\n100ms 软件触发", shape=box, style="filled,rounded", fillcolor="#ffcdd2", fontsize=10, fontname="Microsoft YaHei"];
    }

    subgraph cluster_sem {
        label="信号量（事件通知）";
        fontsize=14; fontname="Microsoft YaHei";
        style="filled"; fillcolor="#e8eaf6"; color="#283593"; penwidth=2;

        s1 [label="LimitSemaphore\n二进制", shape=component, style=filled, fillcolor="#c5cae9", fontsize=9, fontname="Microsoft YaHei"];
        s2 [label="USART3_RxSemaphore\n二进制", shape=component, style=filled, fillcolor="#c5cae9", fontsize=9, fontname="Microsoft YaHei"];
        s3 [label="MotorTargetReached\nSemaphore", shape=component, style=filled, fillcolor="#c5cae9", fontsize=9, fontname="Microsoft YaHei"];
        s4 [label="AbnormalSituation\nSemaphore", shape=component, style=filled, fillcolor="#c5cae9", fontsize=9, fontname="Microsoft YaHei"];
    }

    subgraph cluster_queue {
        label="消息队列（数据传输）";
        fontsize=14; fontname="Microsoft YaHei";
        style="filled"; fillcolor="#e8f5e9"; color="#1b5e20"; penwidth=2;

        q1 [label="TempQueue\n温度", shape=cylinder, style=filled, fillcolor="#c8e6c9", fontsize=9, fontname="Microsoft YaHei"];
        q2 [label="DisQueue\n距离", shape=cylinder, style=filled, fillcolor="#c8e6c9", fontsize=9, fontname="Microsoft YaHei"];
        q3 [label="AbnormalSit.\nDisQueue", shape=cylinder, style=filled, fillcolor="#c8e6c9", fontsize=9, fontname="Microsoft YaHei"];
        q4 [label="LedModeQueue\nLED模式", shape=cylinder, style=filled, fillcolor="#c8e6c9", fontsize=9, fontname="Microsoft YaHei"];
    }

    subgraph cluster_dst {
        label="消费任务";
        fontsize=14; fontname="Microsoft YaHei";
        style="filled"; fillcolor="#fff8e1"; color="#f57f17"; penwidth=2;

        dst1 [label="vTaskLimitSwitch\n限位处理", shape=box, style="filled,rounded", fillcolor="#ffe0b2", fontsize=10, fontname="Microsoft YaHei"];
        dst2 [label="vTaskControl\n指令解析", shape=box, style="filled,rounded", fillcolor="#ffe0b2", fontsize=10, fontname="Microsoft YaHei"];
        dst3 [label="vTaskMotorReached\n中点定位", shape=box, style="filled,rounded", fillcolor="#ffe0b2", fontsize=10, fontname="Microsoft YaHei"];
        dst4 [label="vTaskAbnormalSit.\n异常检测", shape=box, style="filled,rounded", fillcolor="#ffe0b2", fontsize=10, fontname="Microsoft YaHei"];
        dst5 [label="vTaskCommunication\n数据展示", shape=box, style="filled,rounded", fillcolor="#ffe0b2", fontsize=10, fontname="Microsoft YaHei"];
        dst6 [label="vTaskLedMode\nLED控制", shape=box, style="filled,rounded", fillcolor="#ffe0b2", fontsize=10, fontname="Microsoft YaHei"];
    }

    src1 -> s1 [label="xSemaphoreGiveFromISR", fontsize=8, fontname="Microsoft YaHei", color="#c62828"];
    src2 -> s2 [label="xSemaphoreGiveFromISR", fontsize=8, fontname="Microsoft YaHei", color="#c62828"];
    src3 -> s3 [label="xSemaphoreGiveFromISR", fontsize=8, fontname="Microsoft YaHei", color="#c62828"];
    src4 -> s4 [label="xSemaphoreGive", fontsize=8, fontname="Microsoft YaHei", color="#c62828"];

    s1 -> dst1 [label="xSemaphoreTake\nportMAX_DELAY", fontsize=8, fontname="Microsoft YaHei", color="#283593"];
    s2 -> dst2 [label="xSemaphoreTake\nportMAX_DELAY", fontsize=8, fontname="Microsoft YaHei", color="#283593"];
    s3 -> dst3 [label="xSemaphoreTake\nportMAX_DELAY", fontsize=8, fontname="Microsoft YaHei", color="#283593"];
    s4 -> dst4 [label="xSemaphoreTake\nportMAX_DELAY", fontsize=8, fontname="Microsoft YaHei", color="#283593"];

    src4 -> q1 [label="xQueueSend\n温度数据", fontsize=8, fontname="Microsoft YaHei", color="#1b5e20"];
    src4 -> q2 [label="xQueueSend\n距离数据", fontsize=8, fontname="Microsoft YaHei", color="#1b5e20"];
    src4 -> q3 [label="xQueueSend\n距离数据", fontsize=8, fontname="Microsoft YaHei", color="#1b5e20"];
    dst4 -> q4 [label="xQueueSend\nLED模式", fontsize=8, fontname="Microsoft YaHei", color="#1b5e20"];

    q1 -> dst5 [label="xQueueReceive\n温度", fontsize=8, fontname="Microsoft YaHei", color="#1b5e20"];
    q2 -> dst5 [label="xQueueReceive\n距离", fontsize=8, fontname="Microsoft YaHei", color="#1b5e20"];
    q3 -> dst4 [label="xQueueReceive\n距离", fontsize=8, fontname="Microsoft YaHei", color="#1b5e20"];
    q4 -> dst6 [label="xQueueReceive\n模式指令", fontsize=8, fontname="Microsoft YaHei", color="#1b5e20"];
}

digraph G {
    rankdir=TB;
    fontname="Microsoft YaHei";
    fontsize=14;
    label="STM32F107VCT6 教育机器人 — 七版本架构演进图";
    labelloc=t;
    nodesep=0.5;
    ranksep=0.7;
    compound=true;
    newrank=true;
    bgcolor="#fafafa";

    subgraph cluster_bare {
        label="裸机时代（任务1~2）";
        fontsize=16;
        fontname="Microsoft YaHei";
        style="filled";
        fillcolor="#e3f2fd";
        color="#1565c0";
        penwidth=2;

        t1 [label="task1 — 初版\n━━━━━━━━━━━━━━━━\n架构: 裸机轮询\nTIM5: Toggle模式\n速度: 2000 Hz (默认)\n回退: 5900脉冲\n限位: ISR内delay_ms(50)\n障碍物: 3次确认滤波\nRTOS: ✗",
            shape=box, style="filled,rounded", fillcolor="#e3f2fd", fontsize=10, fontname="Microsoft YaHei"];

        t2 [label="task2 — OC翻转电平\n━━━━━━━━━━━━━━━━\n架构: 裸机轮询\nTIM5: PWM1模式 (ARR动态)\n速度: 1000 Hz\n回退: 3050脉冲\n限位: ISR内delay_ms(50)\n障碍物: 3次确认滤波\nRTOS: ✗\n稳定性: 60min+验证",
            shape=box, style="filled,rounded", fillcolor="#bbdefb", fontsize=10, fontname="Microsoft YaHei"];
    }

    subgraph cluster_rtos4 {
        label="FreeRTOS 4任务（任务3~4）";
        fontsize=16;
        fontname="Microsoft YaHei";
        style="filled";
        fillcolor="#c8e6c9";
        color="#2e7d32";
        penwidth=2;

        t3 [label="task3 — FreeRTOS 4任务\n━━━━━━━━━━━━━━━━\n架构: FreeRTOS (4任务)\n任务: 限位/控制/采集/通信\n速度: 1000 Hz\nIPC: 1信号量 + 2队列\n限位: 信号量驱动(非阻塞ISR)\n串口: STOP/START指令\n斜坡: 5 Hz/步",
            shape=box, style="filled,rounded", fillcolor="#c8e6c9", fontsize=10, fontname="Microsoft YaHei"];

        t4 [label="task4 — 电机结构体\n━━━━━━━━━━━━━━━━\n架构: FreeRTOS (4任务)\n任务: 限位/控制/采集/通信\n速度: 1500 Hz\nIPC: 1信号量 + 2队列\nmotor_t结构体状态管理\nstop_pending状态机\n斜坡: 1 Hz/步(极平滑)",
            shape=box, style="filled,rounded", fillcolor="#a5d6a7", fontsize=10, fontname="Microsoft YaHei"];
    }

    subgraph cluster_rtos7 {
        label="FreeRTOS 7任务（任务5~6）";
        fontsize=16;
        fontname="Microsoft YaHei";
        style="filled";
        fillcolor="#fff3e0";
        color="#e65100";
        penwidth=2;

        t5 [label="task5 — FreeRTOS 7任务\n━━━━━━━━━━━━━━━━\n架构: FreeRTOS (7任务)\n新增: 异常/中点到达/LED任务\n速度: 1000 Hz\nIPC: 4信号量 + 4队列\n障碍物自动检测恢复\nLED 4模式独立控制\n中点定位(3050脉冲)\n斜坡: 1 Hz/步",
            shape=box, style="filled,rounded", fillcolor="#ffe0b2", fontsize=10, fontname="Microsoft YaHei"];

        t6 [label="task6 — 宏定义OC翻转\n━━━━━━━━━━━━━━━━\n架构: FreeRTOS (7任务)\n~40个宏定义参数化\nTIM5: OC Toggle模式\nARR固定0xFFFF/动态CCR\n速度: 1600Hz (1rps)\n回退: 2800脉冲 (1.75圈)\n斜坡: 10 Hz/步",
            shape=box, style="filled,rounded", fillcolor="#ffcc80", fontsize=10, fontname="Microsoft YaHei"];
    }

    subgraph cluster_trap {
        label="梯形加减速（任务7）";
        fontsize=16;
        fontname="Microsoft YaHei";
        style="filled";
        fillcolor="#fce4ec";
        color="#880e4f";
        penwidth=2;

        t7 [label="task7 — 梯形加减速\n━━━━━━━━━━━━━━━━\n架构: 裸机电机测试模式\n(7任务已定义,暂未启用)\n电机状态机: STOP→ACCEL→RUN→DECEL→STOP\n梯形运动轮廓(Bresenham离散公式)\n单位制: 0.01圈 (pulse↔unit互转)\n~50个宏定义 + PascalCase API\n整数开方usqrt()避免math.h\n外部可设置加速度/减速度",
            shape=box, style="filled,rounded", fillcolor="#f8bbd0", fontsize=10, fontname="Microsoft YaHei"];
    }

    t1 -> t2 [label="  Toggle→PWM1\n  速度校准\n  稳定性验证", fontsize=9, fontname="Microsoft YaHei", color="#1565c0"];
    t2 -> t3 [label=" 引入FreeRTOS\n ISR→信号量驱动\n 拆分为4任务", fontsize=9, fontname="Microsoft YaHei", color="#2e7d32"];
    t3 -> t4 [label=" motor_t结构体\n stop_pending状态机\n 斜坡降至1Hz/步", fontsize=9, fontname="Microsoft YaHei", color="#2e7d32"];
    t4 -> t5 [label=" 新增3任务\n 全信号量驱动\n 障碍物+LED+中点", fontsize=9, fontname="Microsoft YaHei", color="#e65100"];
    t5 -> t6 [label=" ~40宏定义参数化\n PWM1→OC Toggle\n 脉冲输出模式变更", fontsize=9, fontname="Microsoft YaHei", color="#e65100"];
    t6 -> t7 [label=" 梯形加减速算法\n 单位制距离控制\n PascalCase API重构", fontsize=9, fontname="Microsoft YaHei", color="#880e4f"];
}

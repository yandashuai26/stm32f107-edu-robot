digraph G {
    rankdir=TB;
    fontname="Microsoft YaHei";
    fontsize=14;
    label="STM32F107VCT6 — task7 模块依赖关系图";
    labelloc=t;
    nodesep=0.3;
    ranksep=0.5;
    compound=true;
    bgcolor="#fafafa";

    subgraph cluster_app {
        label="应用层 (main.c)";
        fontsize=14; fontname="Microsoft YaHei";
        style="filled"; fillcolor="#e3f2fd"; color="#1565c0"; penwidth=2;

        main [label="main.c\n━━━━━━━━━━━━━━━━\nBspInit()\nDelayMs(100)\nMotorSetAccel(100)\nMotorSetDecel(100)\nMotorSetSpeed(100)\nMotorSetTargetUnit(500)\nMotorStart()\n// vFreeRtosStart() 注释\n\n注: 7个FreeRTOS任务\n已定义但未启用",
            shape=box, style="filled,rounded", fillcolor="#bbdefb", fontsize=9, fontname="Microsoft YaHei"];
    }

    subgraph cluster_bsp {
        label="BSP 驱动层";
        fontsize=14; fontname="Microsoft YaHei";
        style="filled"; fillcolor="#e8f5e9"; color="#2e7d32"; penwidth=2;

        bsp [label="Bsp.c/h\n━━━━━━━━━━━━━━━━\nBspInit() 统一初始化\nDelayMs() 延时\n汇总所有BSP模块",
            shape=box, style="filled,rounded", fillcolor="#c8e6c9", fontsize=9, fontname="Microsoft YaHei"];
    }

    subgraph cluster_modules {
        label="功能模块 (PascalCase API)";
        fontsize=14; fontname="Microsoft YaHei";
        style="filled"; fillcolor="#fff3e0"; color="#e65100"; penwidth=2;

        motor_m [label="Motor.c/h\n━━━━━━━━━━━━━━━━\nMotorInit() MotorStart()\nMotorStop() MotorSetSpeed()\nMotorSetAccel() MotorSetDecel()\nMotorSetTargetUnit()\nMotorSetConstant() 内部\nusqrt() 整数开方\nMotorPulsesToUnit() 单位转换\n~50个宏定义参数化\nmotor_t 结构体(状态机)",
            shape=box, style="filled,rounded", fillcolor="#ffe0b2", fontsize=9, fontname="Microsoft YaHei"];

        led_m [label="Led.c/h\n━━━━━━━━━━━━━━━━\nLedOn() LedOff()\nPE3/PE4 低电平有效\n4种闪烁模式",
            shape=box, style="filled,rounded", fillcolor="#ffe0b2", fontsize=9, fontname="Microsoft YaHei"];

        gpio [label="Gpio.c/h\n━━━━━━━━━━━━━━\nPC13/PC14 EXTI配置\n限位开关GPIO初始化",
            shape=box, style="filled,rounded", fillcolor="#ffe0b2", fontsize=9, fontname="Microsoft YaHei"];

        timer [label="Timer.c/h\n━━━━━━━━━━━━━━\nTIM1 1ms系统时基\nTIM5 OC Toggle配置\nARR=0xFFFF固定",
            shape=box, style="filled,rounded", fillcolor="#ffe0b2", fontsize=9, fontname="Microsoft YaHei"];

        usart [label="Usart.c/h\n━━━━━━━━━━━━━━\nUSART3 printf重定向\n中断接收帧检测\n波特率115200",
            shape=box, style="filled,rounded", fillcolor="#ffe0b2", fontsize=9, fontname="Microsoft YaHei"];

        oled [label="Oled.c/h\n━━━━━━━━━━━━━━\nSSD1306 I2C驱动\n128x64显示\nOledShowString()\noledfont.h 字库",
            shape=box, style="filled,rounded", fillcolor="#ffe0b2", fontsize=9, fontname="Microsoft YaHei"];

        rs485 [label="485.c/h\n━━━━━━━━━━━━━━\nRS485收发\nGetTemperature()\nGetDistance()\nModbus传感器通信",
            shape=box, style="filled,rounded", fillcolor="#ffe0b2", fontsize=9, fontname="Microsoft YaHei"];
    }

    subgraph cluster_rtos {
        label="FreeRTOS 内核 (已集成,未启用)";
        fontsize=14; fontname="Microsoft YaHei";
        style="filled"; fillcolor="#f3e5f5"; color="#6a1b9a"; penwidth=2;

        rtos [label="freertos/\n━━━━━━━━━━━━━━━━\nFreeRTOS.h / task.h\nqueue.h / semphr.h\nFreeRTOSConfig.h\n\nsrc:\ntasks.c queue.c heap_4.c\nport.c timers.c\n\nFreeRTOS_demo.c/h\n7个任务定义(注释状态)\n4信号量 + 4队列",
            shape=box, style="filled,rounded", fillcolor="#e1bee7", fontsize=9, fontname="Microsoft YaHei"];
    }

    subgraph cluster_hal {
        label="STM32 标准外设库 (SPL)";
        fontsize=14; fontname="Microsoft YaHei";
        style="filled"; fillcolor="#eceff1"; color="#546e7a"; penwidth=2;

        cmsis [label="Drivers/Start/\n━━━━━━━━━━━━━━━━\nstm32f10x.h (寄存器映射)\ncore_cm3.c (CMSIS核心)\nsystem_stm32f10x.c\nstartup_stm32f10x_cl.s",
            shape=box, style="filled,rounded", fillcolor="#cfd8dc", fontsize=9, fontname="Microsoft YaHei"];

        spl [label="Drivers/Library/\n━━━━━━━━━━━━━━━━\nstm32f10x_gpio.c  (GPIO)\nstm32f10x_tim.c   (定时器)\nstm32f10x_usart.c (串口)\nstm32f10x_rcc.c   (时钟)\nstm32f10x_i2c.c   (I2C)\nstm32f10x_exti.c  (外部中断)\nstm32f10x_adc.c   (ADC)\nstm32f10x_dma.c   (DMA)\nmisc.c (NVIC)",
            shape=box, style="filled,rounded", fillcolor="#cfd8dc", fontsize=9, fontname="Microsoft YaHei"];
    }

    main -> bsp [style=bold, color="#2e7d32"];
    main -> rtos [style=dashed, color="#6a1b9a", label="已注释"];

    bsp -> motor_m [color="#e65100"];
    bsp -> led_m [color="#e65100"];
    bsp -> gpio [color="#e65100"];
    bsp -> timer [color="#e65100"];
    bsp -> usart [color="#e65100"];
    bsp -> oled [color="#e65100"];
    bsp -> rs485 [color="#e65100"];

    motor_m -> spl [style=dotted, color="#78909c", label="TIM5 TIM1"];
    gpio -> spl [style=dotted, color="#78909c", label="EXTI GPIO"];
    timer -> spl [style=dotted, color="#78909c", label="TIM"];
    usart -> spl [style=dotted, color="#78909c", label="USART"];
    oled -> spl [style=dotted, color="#78909c", label="I2C GPIO"];
    rs485 -> spl [style=dotted, color="#78909c", label="USART DMA"];

    motor_m -> cmsis [style=dotted, color="#90a4ae"];
    rtos -> cmsis [style=dotted, color="#90a4ae"];
    gpio -> cmsis [style=dotted, color="#90a4ae"];
}
